# ── Core ────────────────────────────────────────────────────────────────
STUDIO_ENV=development
# Off only for tests and throwaway instances. False means a restart loses every
# job, channel, booking — and the day's quota spend, so the next upload silently
# overruns Google's ceiling.
STUDIO_PERSIST=true

# Both of these are COMMENTED OUT on purpose. Left unset, the engine uses SQLite
# at ./storage/studio.db and runs renders inside the API — no Docker, no database
# server, nothing to install. Uncomment them once `docker compose up -d` is
# running, which is what you want for anything beyond trying it out: Postgres
# handles concurrent writers, and Redis moves renders into a worker so restarting
# the API cannot kill one mid-encode.
# STUDIO_DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:5432/studio
# STUDIO_REDIS_URL=redis://localhost:6379/0

# Encrypts YouTube refresh tokens at rest. Change it before connecting a channel;
# changing it afterwards invalidates stored tokens and you re-authorise.
# Leave this commented out. A random per-install key is generated on first
# use and kept in storage/.secret_key — it protects your YouTube refresh
# tokens, so back that file up. Set this only to pin a key you manage
# yourself (32+ characters), e.g. to share one across several machines.
# STUDIO_SECRET_KEY=

# ── Storage ─────────────────────────────────────────────────────────────
# Local only. There is no S3 backend yet, so "s3" is rejected at startup rather
# than silently writing to local disk and losing it all on container recycle.
STUDIO_STORAGE_BACKEND=local
STUDIO_STORAGE_ROOT=./storage

# ── LLM ─────────────────────────────────────────────────────────────────
# Model choice is NOT set here. Each task is routed independently — see the
# Models screen, or GET /v1/models. Only the keys live in the environment.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── TTS ─────────────────────────────────────────────────────────────────
# Edge is the only implemented provider. Voices: `edge-tts --list-voices`.
STUDIO_TTS_PROVIDER=edge
STUDIO_TTS_VOICE=en-US-AvaNeural

# ── Stock footage ───────────────────────────────────────────────────────
# Pexels is tried first; Pixabay fills whatever it could not. Either alone
# works — a beat with no footage is a hole in the video, so set both if you can.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Keyword grounding fallback ──────────────────────────────────────────
# Optional. YouTube autocomplete and DuckDuckGo need no key, which is why they
# are the default — but both routinely block datacenter IPs, and on a cloud host
# they can fail together and take the first stage of the only workflow with them.
# Any endpoint answering GET {url}?q=seed with a JSON list of keywords works.
# Tried only when the free sources return nothing.
# KEYWORD_API_URL=
# KEYWORD_API_KEY=

# ── Render look ─────────────────────────────────────────────────────────
# Subtitle font. A path, or a filename dropped into ./storage/fonts.
# Empty falls back to a system font (the engine image installs DejaVu).
# STUDIO_SUBTITLE_FONT=
STUDIO_KEN_BURNS=alternate          # none | in | out | alternate
# Hard cuts by default — fast-cut faceless video does not dissolve between
# shots. Non-zero gives a true crossfade (clips overlap; it never dips to black).
STUDIO_TRANSITION_FADE_S=0

# ── Background music ────────────────────────────────────────────────────
# Off, and empty, on purpose. Nothing ships with music — MoneyPrinterTurbo's
# bundled resource/songs has unclear provenance and is not carried over.
# Point this at tracks you have the right to publish. See KNOWN-ISSUES.md §3.3.
STUDIO_BGM_ENABLED=false
# STUDIO_BGM_DIR=                   # defaults to ./storage/bgm
STUDIO_BGM_VOLUME=0.12              # under a -3dB narration bed

# ── YouTube ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
# Google's default grant. Raise this only if they actually approve an extension —
# an upload costs 1,600 units, so the default is ~4 publishes a day.
STUDIO_YOUTUBE_DAILY_QUOTA=10000

# ── TikTok (Repurpose tab, Lane A) ───────────────────────────────────────
# Lists your own TikTok posts so you can re-edit them into YouTube videos.
# See docs/TIKTOK-SETUP.md for the full walkthrough — registering the app with
# TikTok takes days, so start that before anything else in this file.
# Get exactly these names right: it is TIKTOK_CLIENT_KEY, not
# STUDIO_TIKTOK_CLIENT_KEY. Every other credential in this file takes no
# STUDIO_ prefix either, but this is the pair that has actually cost people
# time — the screen keeps saying "not configured" while the value sits right
# there under the wrong name.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional. TikTok's Creative Center has no public API, so most people leave
# this empty — freshness then scores zero rather than being invented.
# TIKTOK_TRENDS_URL=

# ── Guardrails ──────────────────────────────────────────────────────────
# A runaway workflow is a billing incident, and N concurrent MoviePy encodes
# will saturate any machine. Both are enforced, not advisory.
STUDIO_MAX_COST_PER_VIDEO_USD=8.0
STUDIO_MAX_CONCURRENT_RENDERS=2

# ── Auth ────────────────────────────────────────────────────────────────
# The engine is unauthenticated by default — fine on a machine only you use,
# not fine the moment anything else can reach this port (KNOWN-ISSUES.md §6:
# CORS trusts http://localhost:3000, which is any dev server on that port, not
# specifically this one). Set a random 32+ character value to turn the gate
# on; leave both commented out and nothing changes. Set both to the SAME
# value — the second is deliberately readable by the browser, for the two
# things (live render preview, job progress) a browser has to fetch directly
# and cannot attach a header to. See engine/auth.py for what each protects.
# STUDIO_API_TOKEN=
# NEXT_PUBLIC_STUDIO_API_TOKEN=

# ── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENGINE_URL=http://localhost:8080

# Thumbnail backgrounds via GPT Image. "auto" uses OPENAI_API_KEY if it is set,
# otherwise GEMINI_API_KEY — no extra key, no extra account. With neither, thumbnails
# compose over a flat panel instead of failing. Set "none" to force that off.
# STUDIO_IMAGE_PROVIDER=auto

# Where the web app is, from your browser's point of view. Only used to send you
# back to the Setup screen after Google's OAuth consent page. The default is right
# for both `npm start` and docker compose; change it if you moved the web app off
# port 3000 or are reaching it over a LAN address.
# STUDIO_WEB_URL=http://localhost:3000
