# No trailing slash: with one, this matches only directories, and a *symlink*
# named node_modules sails past it. That happened — self-referential symlinks
# got committed, and every fresh clone came up with an unusable install.
node_modules
.next/
out/
dist/
build/
*.tsbuildinfo

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

.env
.env.*
!.env.example
*.pem
client_secret*.json
token*.json

storage/
!storage/.gitkeep

.DS_Store
Thumbs.db
.claude/worktrees/
.claude/settings.local.json

# Local Postgres and Redis data from the dev/test harness
pgdata/
dump.rdb

# Generated by scripts/install-shortcut.mjs at install time, per machine.
scripts/studio-launch.sh

# Written by setup.ps1 to interrogate the Python interpreters on the machine, and
# deleted again when it finishes. Only survives a setup that died partway.
studio-python-probe.py

# MoviePy writes its intermediate audio beside the output rather than in a temp
# directory, named after the clip it came from. A render that raises — which the
# repurpose tests do deliberately — leaves one behind, in the repo root or in
# `apps/engine/` depending on where pytest was started from. They are never worth
# committing, and an untracked file with a random name in `git status` is how a
# real change gets lost in the noise.
*TEMP_MPY_*.mp4
*TEMP_MPY_*.mp3
